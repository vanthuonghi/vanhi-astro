---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} canonical={`https://vanhi.id.vn/blog/${post.id}/`}>
  <article class="post-content">
    <h1>{post.data.title}</h1>
    <p class="post-meta">{new Intl.DateTimeFormat('vi-VN', {day:'2-digit',month:'2-digit',year:'numeric'}).format(post.data.date)}</p>
    <div class="post-body">
      <Content />
    </div>
    <div class="cta-box">
      <h3>📩 Muốn biết thêm?</h3>
      <p>Đăng ký email để nhận hướng dẫn AI Agent mới nhất từ Văn Hỉ</p>
      <form class="lead-form" action="https://crm.speedreading.vn/?fluentcrm=1&route=contact&hash=8542ba92-3bca-46fb-baee-1371d1899a36" method="POST">
        <input type="hidden" name="source" value="vanhi.id.vn" />
        <input type="email" name="email" placeholder="Nhập email của bạn..." required />
        <input type="hidden" name="first_name" value="" />
        <button type="submit">Đăng ký</button>
      </form>
      <p class="lead-note">📩 Không spam. Hủy bất cứ lúc nào.</p>
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll('.lead-form').forEach(form => {
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      const btn = this.querySelector('button');
      const email = this.querySelector('input[name="email"]');
      const originalText = btn.textContent;
      btn.textContent = 'Đang gửi...';
      btn.disabled = true;
      try {
        const resp = await fetch(this.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: email.value,
            source: 'vanhi.id.vn',
            first_name: '',
            status: 'subscribed'
          })
        });
        const data = await resp.json();
        if (data.success) {
          btn.textContent = '✅ Đã đăng ký!';
          email.value = '';
        } else {
          btn.textContent = '❌ Lỗi, thử lại';
          setTimeout(() => { btn.textContent = originalText; btn.disabled = false; }, 2000);
        }
      } catch(e) {
        btn.textContent = '❌ Lỗi kết nối';
        setTimeout(() => { btn.textContent = originalText; btn.disabled = false; }, 2000);
      }
    });
  });
</script>